class MonthlyUsageAnalyser {
   static final int SLAB1_LIMIT = 100;
   static final int SLAB2_LIMIT = 200;
   public static void main(String[] args) {
       int[] usage = {
           120, 150, 180, 90, 220, 250,
           190, 160, 130, 210, 170, 200
       };
       long total = 0;
       int max = usage[0];
       int min = usage[0];
       for (int value : usage) {
           total += value;
           if (value > max) {
               max = value;
           }
           if (value < min) {
               min = value;
           }
       }
       double average = (double) total / usage.length;
       char grade = average <= 150 ? 'A'
                  : average <= 200 ? 'B'
                  : average <= 250 ? 'C' : 'D';
       System.out.println("Total Usage: " + total);
       System.out.println("Average: " + average);
       System.out.println("Maximum: " + max);
       System.out.println("Minimum: " + min);
       System.out.println("Grade: " + grade);
       long bill = calculateBill(usage[0]);
       System.out.println("January Bill: " + bill);
       int[][] houses = {
           {120,150,180,90,220,250,190,160,130,210,170,200},
           {100,130,160,110,180,200,170,150,120,190,160,180},
           {200,220,240,180,260,280,230,210,190,250,220,240}
       };
       for (int i = 0; i < houses.length; i++) {
           long houseTotal = 0;
           for (int value : houses[i]) {
               houseTotal += value;
           }
           System.out.println(
               "House " + (i + 1) + " Total: " + houseTotal
           );
       }
   }
   static long calculateBill(int units) {
       if (units <= SLAB1_LIMIT) {
           return units * 2L;
       }
       if (units <= SLAB2_LIMIT) {
           return SLAB1_LIMIT * 2L
                + ((long) units - SLAB1_LIMIT) * 4L;
       }
       return SLAB1_LIMIT * 2L
            + (SLAB2_LIMIT - SLAB1_LIMIT) * 4L
            + ((long) units - SLAB2_LIMIT) * 6L;
   }
}


