
package orders;

public class InsufficientStockException extends Exception {
    public InsufficientStockException(String message, Throwable cause) {
        super(message, cause);
    }
}


package orders;

public class InvalidQuantityException extends RuntimeException {
    public InvalidQuantityException(String message) {
        super(message);
    }
}



package orders;

import java.util.logging.Logger;

public class OrderProcessor {
    private static final Logger LOGGER =
            Logger.getLogger(OrderProcessor.class.getName());

    static void processOrder(int stock, int quantity)
            throws InsufficientStockException {

        try {
            if (quantity <= 0) {
                throw new InvalidQuantityException(
                        "Quantity must be greater than zero.");
            }

            if (quantity > stock) {
                IllegalStateException cause =
                        new IllegalStateException(
                                "Inventory check failed: insufficient stock.");

                throw new InsufficientStockException(
                        "Requested " + quantity + ", available " + stock,
                        cause);
            }

            System.out.println("Order processed: " + quantity + " item(s).");

        } catch (InsufficientStockException
                 | InvalidQuantityException ex) {
            System.out.println("Order failed: " + ex.getMessage());
            ex.printStackTrace(System.out);

            if (ex.getCause() != null) {
                System.out.println("Underlying cause: "
                        + ex.getCause().getMessage());
            }

        } finally {
            LOGGER.info("AUDIT: Order processing attempt completed.");
        }
    }

    public static void main(String[] args)
            throws InsufficientStockException {
        processOrder(5, 8);
        processOrder(5, -2);
        processOrder(5, 3);
    }
}


